# Doxygen API/source browser for the repository's LEGACY and FRAMEWORK APIs.
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = infrared_framework
PROJECT_BRIEF          = "RT-Thread infrared protocol and device framework"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = _ci/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
INPUT                  = inc src framework/inc framework/src framework/codecs framework/examples tools/doxygen/mainpage.md
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/* */_ci/*
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = tools/doxygen/mainpage.md
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
SHOW_INCLUDE_FILES     = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
DOT_NUM_THREADS        = 2
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = _ci/doxygen-warnings.log
QUIET                  = YES
